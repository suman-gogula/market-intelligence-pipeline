# Copy this file to ".env" and edit the copy. ".env" is ignored by git.
# Every value is optional: with no .env at all the demo runs locally on SQLite.

# Local SQLite file (default) or a PostgreSQL URL.
# PostgreSQL example (needs: pip install -r requirements-postgres.txt):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=sqlite:///data/local/market_intel.db

LOG_LEVEL=INFO
# text or json
LOG_FORMAT=text

# Network behaviour for live APIs
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
# Remotive asks for at most 4 fetches per day, so keep this modest.
REMOTIVE_LIMIT=50

# Optional AI labelling. Leave GEMINI_API_KEY empty to run without AI.
# Create a key in Google AI Studio. Check the current model names and free-tier limits there.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_JOBS_PER_RUN=20
GEMINI_MIN_INTERVAL_SECONDS=6
